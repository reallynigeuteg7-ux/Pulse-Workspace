<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0D0D" Foreground="#F7F7F7" FontSize="12"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Muted" Color="#969696"/>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#202020"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="BorderBrush" Value="#363636"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#F5F5F5"/>
      <Setter Property="Foreground" Value="#111111"/>
      <Setter Property="BorderBrush" Value="#F5F5F5"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Foreground" Value="#AAAAAA"/>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101010"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="BorderBrush" Value="#393939"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="#666666"/>
      <Setter Property="Padding" Value="13,12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#171717"/>
      <Setter Property="BorderBrush" Value="#2B2B2B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Background" Value="#171717"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#444444" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border BorderBrush="#343434" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="#111111" BorderBrush="#242424" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock Text="PULSE   /   SERVER TESTING" Foreground="#868686" FontSize="9" FontWeight="SemiBold" Margin="22,0,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="—" AutomationProperties.Name="Свернуть"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="□" AutomationProperties.Name="Развернуть"/>
            <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="×" FontSize="20" AutomationProperties.Name="Закрыть"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#111111" BorderBrush="#282828" BorderThickness="0,0,1,0" Padding="18,30,18,20">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="6,0,0,40">
                <Border Background="#F4F4F4" Width="33" Height="33" CornerRadius="9" Margin="0,0,11,0">
                  <Path Stroke="#101010" StrokeThickness="2" Data="M 0,9 L 5,9 8,2 12,16 15,9 21,9" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PULSE" FontSize="23" FontWeight="Bold"/>
              </StackPanel>
              <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Style="{StaticResource Caption}" FontSize="8" Margin="14,0,0,14"/>
              <Button x:Name="TestNav" Style="{StaticResource Nav}" Background="#F0F0F0" Foreground="#111111" Content="↗   Нагрузочный тест"/>
              <Button x:Name="HistoryNav" Style="{StaticResource Nav}" Content="≡   История сессии"/>
              <Button x:Name="HelpNav" Style="{StaticResource Nav}" Content="?   Как это работает"/>
            </StackPanel>
            <StackPanel Grid.Row="2">
              <Border BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                  <TextBlock Text="КОНТРОЛЬ НАГРУЗКИ" FontSize="8" FontWeight="SemiBold" Foreground="#ADADAD" Margin="0,0,0,12"/>
                  <TextBlock Text="100 запросов / с" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                  <TextBlock Text="До 4 соединений&#10;До 120 секунд" Foreground="#949494" FontSize="10" LineHeight="19"/>
                </StackPanel>
              </Border>
              <TextBlock Text="PULSE 1.0   ·   C# / WINDOWS" FontSize="8" Foreground="#727272" Margin="8,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="30,25,30,18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,22">
            <StackPanel>
              <TextBlock Text="ОБЗОР   /   HTTP" Style="{StaticResource Caption}" FontSize="9" Margin="0,0,0,8"/>
              <TextBlock x:Name="PageTitle" Text="Нагрузочный тест" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <TextBlock x:Name="PageSubtitle" Text="Измеряйте отклик. Наблюдайте за стабильностью." Foreground="#A0A0A0" FontSize="11"/>
            </StackPanel>
            <Border Background="#1A1A1A" BorderBrush="#353535" BorderThickness="1" CornerRadius="15" Padding="13,7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,0,0">
              <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#BDBDBD" Width="5" Height="5" Margin="0,0,7,0"/><TextBlock x:Name="StatusBadge" Text="Ожидание" FontSize="10"/></StackPanel>
            </Border>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <Grid>
              <StackPanel x:Name="TestPage">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <Grid Margin="0,0,0,14">
                      <TextBlock Text="01   Параметры теста" FontWeight="SemiBold" FontSize="13"/>
                      <TextBlock Text="HTTP / HTTPS" Style="{StaticResource Caption}" HorizontalAlignment="Right" FontSize="9"/>
                    </Grid>
                    <TextBlock Text="Адрес сервера" Foreground="#B2B2B2" FontSize="10" Margin="0,0,0,7"/>
                    <Grid Margin="0,0,0,16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBox x:Name="TargetInput" Text="http://localhost:8080/" FontSize="13" AutomationProperties.Name="Адрес сервера"/>
                      <Button x:Name="ProbeButton" Grid.Column="2" Content="Проверить" Padding="17,10"/>
                    </Grid>
                    <Grid Margin="0,0,0,17">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Частота · запросов/с" Foreground="#B2B2B2" FontSize="10" Margin="0,0,0,7"/>
                        <TextBox x:Name="RateInput" Text="100" AutomationProperties.Name="Запросов в секунду от 1 до 100"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Длительность · секунды" Foreground="#B2B2B2" FontSize="10" Margin="0,0,0,7"/>
                        <TextBox x:Name="DurationInput" Text="30" AutomationProperties.Name="Длительность от 5 до 120 секунд"/>
                      </StackPanel>
                      <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,3">
                        <TextBlock Text="GET   ·   тайм-аут 5 с" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,8"/>
                        <TextBlock x:Name="PlannedLabel" Text="До 3000 запросов за тест" Foreground="#999999" FontSize="10"/>
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Button x:Name="StartButton" Content="▶   Запустить тест" Style="{StaticResource Primary}" Padding="20,12"/>
                      <Button x:Name="StopButton" Grid.Column="2" Content="■   Стоп" IsEnabled="False" Padding="16,12"/>
                      <TextBlock Grid.Column="3" Text="Автостоп при HTTP 429 / 503" Foreground="#8D8D8D" FontSize="9" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                    <Border x:Name="NoticeBox" Visibility="Collapsed" Background="#222222" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                      <TextBlock x:Name="NoticeText" FontSize="11" Foreground="#DDDDDD" LineHeight="18"/>
                    </Border>
                    <Border x:Name="ProbeDetailsBox" Visibility="Collapsed" Background="#101010" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                      <TextBox x:Name="ProbeDetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" FontSize="10" BorderThickness="0" Padding="0"/>
                    </Border>
                  </StackPanel>
                </Border>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource Card}" Padding="17,15"><StackPanel><TextBlock Text="ЗАВЕРШЕНО" Style="{StaticResource Caption}" FontSize="8"/><TextBlock x:Name="RequestsValue" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="RequestFoot" Text="запросов" Foreground="#868686" FontSize="9"/></StackPanel></Border>
                  <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,15"><StackPanel><TextBlock Text="СРЕДНИЙ ОТКЛИК" Style="{StaticResource Caption}" FontSize="8"/><TextBlock x:Name="AverageValue" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock Text="мс · до заголовков" Foreground="#868686" FontSize="9"/></StackPanel></Border>
                  <Border Grid.Column="4" Style="{StaticResource Card}" Padding="17,15"><StackPanel><TextBlock Text="95-Й ПЕРЦЕНТИЛЬ" Style="{StaticResource Caption}" FontSize="8"/><TextBlock x:Name="P95Value" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock Text="мс · до заголовков" Foreground="#868686" FontSize="9"/></StackPanel></Border>
                  <Border Grid.Column="6" Style="{StaticResource Card}" Padding="17,15"><StackPanel><TextBlock Text="ОШИБКИ" Style="{StaticResource Caption}" FontSize="8"/><TextBlock x:Name="ErrorsValue" Text="0%" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="ErrorsFoot" Text="0 из 0 запросов" Foreground="#868686" FontSize="9"/></StackPanel></Border>
                </Grid>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <Grid Margin="0,0,0,10"><TextBlock Text="02   Время отклика" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="—  Среднее за секунду, мс" Foreground="#949494" FontSize="9" HorizontalAlignment="Right"/></Grid>
                    <Grid x:Name="ChartHost" Height="138" ClipToBounds="True"/>
                    <Grid Margin="0,8,0,10"><TextBlock x:Name="ElapsedLabel" Text="00:00 / 00:30" Foreground="#A8A8A8" FontSize="10"/><TextBlock x:Name="ChartHint" Text="Ожидание первого запроса" Foreground="#868686" FontSize="9" HorizontalAlignment="Right"/></Grid>
                    <Grid x:Name="ProgressTrack" Height="3" Background="#303030" ClipToBounds="True"><Border x:Name="ProgressFill" Background="#EEEEEE" HorizontalAlignment="Left" Width="0"/></Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="22,17">
                  <StackPanel>
                    <Grid Margin="0,0,0,12"><TextBlock Text="03   Журнал запросов" FontWeight="SemiBold" FontSize="13"/><Button x:Name="ExportButton" Content="↓   Экспорт CSV" Padding="12,6" FontSize="10" HorizontalAlignment="Right" IsEnabled="False"/></Grid>
                    <TextBlock x:Name="LogEmpty" Text="Здесь появятся HTTP-статусы и задержки запросов." Foreground="#898989" FontSize="10" Margin="0,2,0,6"/>
                    <StackPanel x:Name="LogRows"/>
                    <TextBlock x:Name="LogFoot" Visibility="Collapsed" Foreground="#808080" FontSize="9" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Последние тесты" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock Text="История хранится до закрытия приложения. Сохраните нужные результаты в CSV." Foreground="#A0A0A0" FontSize="11" LineHeight="19" Margin="0,0,0,20"/><TextBlock x:Name="HistoryEmpty" Text="Тестов пока нет. Запустите первый тест на вкладке слева." Foreground="#858585"/><StackPanel x:Name="HistoryRows"/></StackPanel></Border>
              </StackPanel>
              <StackPanel x:Name="HelpPage" Visibility="Collapsed">
                <Border Style="{StaticResource Card}"><StackPanel>
                  <TextBlock Text="Знайте, как отвечает ваш сервер." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,22"/>
                  <TextBlock Text="01  Укажите HTTP(S)-адрес" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <TextBlock Text="«Проверить» отправляет один GET-запрос, показывает HTTP-статус, заголовки и время до их получения. Для локального сервера можно использовать http://localhost:8080/." Foreground="#AAAAAA" FontSize="12" LineHeight="22" Margin="0,0,0,22"/>
                  <TextBlock Text="02  Настройте короткий тест" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <TextBlock Text="От 1 до 100 запросов в секунду, от 5 до 120 секунд. Не более четырёх запросов одновременно. Когда все соединения заняты, запланированный запрос пропускается. Пропуски не накапливаются в очередь." Foreground="#AAAAAA" FontSize="12" LineHeight="22" Margin="0,0,0,22"/>
                  <TextBlock Text="03  Наблюдайте и сравнивайте" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <TextBlock Text="Отклик — время до заголовков ответа (TTFB), а не полной загрузки страницы. P95 — задержка, которую не превышают 95% ответов. Ошибкой считается ответ вне 2xx или сбой сети. Отменённые запросы считаются отдельно." Foreground="#AAAAAA" FontSize="12" LineHeight="22" Margin="0,0,0,22"/>
                  <Border Background="#222222" CornerRadius="8" Padding="16"><TextBlock Text="HTTP 429/503 и пять ошибок соединения подряд останавливают тест. Тайм-аут запроса — 5 секунд. Тело ответа читается максимум до 64 КиБ. Редиректы, cookies, системный прокси и повторные попытки отключены. Проверка TLS-сертификата остаётся включённой." Foreground="#CCCCCC" FontSize="11" LineHeight="21"/></Border>
                  <TextBlock Text="Esc — остановить тест. Ctrl+Enter — запустить. CSV содержит параметры теста и все результаты с временем в UTC. URL и ответы не сохраняются автоматически на диск." Foreground="#888888" FontSize="10" LineHeight="19" Margin="0,22,0,0"/>
                </StackPanel></Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <Grid Grid.Row="2" Margin="0,15,0,0">
            <TextBlock x:Name="FooterText" Text="Готов к работе" Foreground="#777777" FontSize="9"/>
            <TextBlock Text="HTTP   ·   ESC — СТОП" Foreground="#686868" FontSize="8" HorizontalAlignment="Right"/>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
